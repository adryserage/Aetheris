# Auto detect text files and perform LF normalization
* text=auto

# Ensure shell scripts use LF
*.sh text eol=lf

# Ensure Python files use LF
*.py text eol=lf

# Ensure YAML files use LF
*.yml text eol=lf
*.yaml text eol=lf

# Ensure JSON files use LF
*.json text eol=lf

# Ensure Markdown files use LF
*.md text eol=lf

# Ensure workflow files use LF
.github/workflows/*.yml text eol=lf
.github/workflows/*.yaml text eol=lf
