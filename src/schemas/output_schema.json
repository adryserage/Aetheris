{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aetheris.dev/schemas/output-v1.json",
  "title": "Aetheris Execution Output Schema",
  "description": "Schema for Aetheris headless execution output",
  "type": "object",
  "required": ["status", "exit_code", "duration_ms"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "error", "timeout", "interrupted", "blocked"],
      "description": "Execution status"
    },
    "exit_code": {
      "type": "integer",
      "enum": [0, 1, 2],
      "description": "Exit code: 0=success, 1=error, 2=warning"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Execution duration in milliseconds"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Execution timestamp (ISO 8601)"
    },
    "version": {
      "type": "string",
      "description": "Aetheris version"
    },
    "task": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Task type that was executed"
        },
        "files_processed": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of files processed"
        },
        "source_file": {
          "type": "string",
          "description": "Path to task file that was executed"
        }
      },
      "additionalProperties": true
    },
    "results": {
      "type": "object",
      "properties": {
        "issues_found": {
          "type": "integer",
          "minimum": 0
        },
        "issues_fixed": {
          "type": "integer",
          "minimum": 0
        },
        "critical": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "reports": {
          "type": "array",
          "items": {"type": "string"},
          "description": "List of generated report paths"
        }
      },
      "additionalProperties": true
    },
    "diff": {
      "oneOf": [
        {"type": "string"},
        {"type": "null"}
      ],
      "description": "Unified diff of code modifications (if any)"
    },
    "logs": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Execution log messages"
    },
    "stdout": {
      "type": "string",
      "description": "Captured stdout output"
    },
    "stderr": {
      "type": "string",
      "description": "Captured stderr output"
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "Error type identifier"
            },
            "message": {
              "type": "string",
              "description": "Error message"
            },
            "details": {
              "type": "object",
              "description": "Additional error details"
            },
            "traceback": {
              "type": "string",
              "description": "Stack trace (if available)"
            }
          },
          "required": ["type", "message"]
        },
        {"type": "null"}
      ],
      "description": "Error information (null if no error)"
    },
    "blocked_operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operation": {"type": "string"},
          "reason": {"type": "string"},
          "profile": {"type": "string"}
        }
      },
      "description": "Operations blocked by security profile"
    },
    "metadata": {
      "type": "object",
      "description": "Metadata from task file or execution context",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
