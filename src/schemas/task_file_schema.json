{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aetheris.dev/schemas/task-file-v1.json",
  "title": "Aetheris Task File Schema",
  "description": "Schema for Aetheris headless task files (JSON/YAML)",
  "type": "object",
  "required": ["version", "task"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0"],
      "description": "Schema version"
    },
    "task": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["analysis", "fix", "pr", "issues", "stats", "cleanup", "validate-package"],
          "description": "Type of task to execute"
        },
        "target": {
          "type": "object",
          "properties": {
            "files": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {"type": "string"},
                  "description": "List of file paths or glob patterns"
                },
                {
                  "type": "string",
                  "description": "Single file path or glob pattern"
                }
              ]
            },
            "changed_only": {
              "type": "boolean",
              "default": false,
              "description": "Analyze only changed files since last run"
            },
            "exclude": {
              "type": "array",
              "items": {"type": "string"},
              "description": "Patterns to exclude from analysis"
            }
          },
          "additionalProperties": false
        },
        "options": {
          "type": "object",
          "properties": {
            "timeout": {
              "oneOf": [
                {"type": "integer", "minimum": 0},
                {"type": "string", "pattern": "^(\\d+[smh]?|no-limit|unlimited)$"}
              ],
              "description": "Execution timeout (seconds, or '30m', '2h', '0' for unlimited)"
            },
            "profile": {
              "type": "string",
              "enum": ["safe", "ci", "dev", "unrestricted"],
              "default": "safe",
              "description": "Security profile for execution"
            },
            "agents": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["security", "architecture", "quality", "metrics", "dependency", "qa"]
              },
              "description": "Specific agents to run (default: all)"
            },
            "provider": {
              "type": "string",
              "enum": ["gemini", "openai", "claude"],
              "description": "AI provider to use"
            },
            "verbose": {
              "type": "boolean",
              "default": false,
              "description": "Enable verbose logging"
            },
            "dry_run": {
              "type": "boolean",
              "default": false,
              "description": "Validate without executing"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": ["json", "yaml"],
          "default": "json",
          "description": "Output format"
        },
        "include_diff": {
          "type": "boolean",
          "default": true,
          "description": "Include code diffs in output"
        },
        "include_logs": {
          "type": "boolean",
          "default": true,
          "description": "Include execution logs in output"
        },
        "file": {
          "type": "string",
          "description": "Write output to file instead of stdout"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "description": "Optional metadata for tracking",
      "properties": {
        "run_id": {"type": "string"},
        "triggered_by": {"type": "string"},
        "pipeline": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
