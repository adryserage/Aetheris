# MANIFEST.in - Control what goes into source distribution
# For Cython binary distribution, we exclude Python source files

# Include essential files
include README.md
include README.fr.md
include LICENSE
include NOTICE
include pyproject.toml
include setup.py

# Include locale files (JSON translations) - CRITICAL for i18n
recursive-include src/locales *.json

# Include package __init__.py files (needed as stubs for imports)
recursive-include src __init__.py

# Exclude all Python source files from sdist
global-exclude *.py
global-exclude *.pyx
global-exclude *.pxd

# Re-include __init__.py files after global exclude
recursive-include src __init__.py

# Exclude build artifacts
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.so
global-exclude *.pyd
global-exclude __pycache__
prune build
prune dist
prune *.egg-info

# Exclude development/CI files (not needed in distribution)
prune scripts
prune assets
prune specs
prune tests
prune .github
prune docs
prune fixtures
prune mocks
global-exclude *.svg

# Exclude security-sensitive files (NEVER include in distribution)
global-exclude .env
global-exclude .env.*
global-exclude secrets.json
global-exclude secrets.yaml
global-exclude credentials.json
global-exclude *.pem
global-exclude *.key
global-exclude id_rsa*
global-exclude id_ed25519*

# Exclude OS-generated files
global-exclude .DS_Store
global-exclude Thumbs.db
global-exclude desktop.ini
global-exclude ._*

# Exclude development config files
global-exclude .eslintrc*
global-exclude .prettierrc*
global-exclude .editorconfig
global-exclude pytest.ini
global-exclude .coveragerc
global-exclude .flake8
global-exclude .mypy.ini
global-exclude mypy.ini
global-exclude .ruff.toml
global-exclude ruff.toml

# Exclude test files
global-exclude *_test.py
global-exclude test_*.py
global-exclude conftest.py

# Exclude IDE/editor files
prune .vscode
prune .idea
global-exclude *.swp
global-exclude *.swo
global-exclude *~
