include README.md
include README.fr.md
include LICENSE
include NOTICE
include CHANGELOG.md
recursive-include aetheris/rules *.yaml

prune build
prune dist
prune docs
prune assets
prune scripts
prune .github
prune .agents
global-exclude *.pyc *.pyo *.so __pycache__
global-exclude .env .env.* *.pem *.key
