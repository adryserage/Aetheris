# MANIFEST.in - Control what goes into source distribution
# For Cython binary distribution, we exclude Python source files

# Include essential files
include README.md
include LICENSE
include pyproject.toml
include setup.py

# Include package __init__.py files (needed as stubs for imports)
recursive-include src __init__.py

# Exclude all Python source files from sdist
global-exclude *.py
global-exclude *.pyx
global-exclude *.pxd

# Re-include __init__.py files after global exclude
recursive-include src __init__.py

# Exclude build artifacts
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.so
global-exclude *.pyd
global-exclude __pycache__
prune build
prune dist
prune *.egg-info

# Exclude development/CI files (not needed in distribution)
prune scripts
prune assets
prune specs
prune tests
prune .github
global-exclude *.svg
