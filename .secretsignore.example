# .secretsignore - Patterns to ignore during secret scanning
# Copy this file to .secretsignore and customize for your project
#
# Syntax:
# - File patterns: Match files by name or glob pattern
# - Content patterns: Match specific strings (exact match)
# - Comments: Lines starting with # are ignored
# - Empty lines are ignored

# =============================================================================
# FILE PATTERNS
# =============================================================================

# Test files often contain fake secrets for testing
tests/fixtures/*
**/test_*.py
**/*_test.py

# Example/sample files
*.example
*.sample
*.template

# Documentation with example secrets
docs/examples/*
examples/*

# =============================================================================
# CONTENT PATTERNS (exact match in line)
# =============================================================================

# Common placeholder values
CHANGEME
YOUR_API_KEY_HERE
xxxxxxxxxxxx
placeholder
dummy_key
test_key
fake_key

# Base64 encoded example strings
dGVzdA==
ZXhhbXBsZQ==

# SHA256 hashes (often mistaken for secrets)
# Add specific known hashes here if they trigger false positives

# =============================================================================
# PROJECT-SPECIFIC EXCLUSIONS
# =============================================================================

# Add your project-specific exclusions below
# Example: specific test fixtures, mock data, etc.
