{
  "version": "1.0",
  "description": "Default command allowlist for safe mode (v2.12)",
  "patterns": [
    "git *",
    "git-*",
    "pytest *",
    "python -m pytest *",
    "py.test *",
    "python -m unittest *",
    "black *",
    "ruff *",
    "ruff check *",
    "ruff format *",
    "mypy *",
    "python -m mypy *",
    "flake8 *",
    "isort *",
    "pylint *",
    "pyright *",
    "pip list",
    "pip show *",
    "pip freeze",
    "python --version",
    "python3 --version",
    "npm test",
    "npm run test",
    "npm run lint",
    "npx jest *",
    "npx eslint *",
    "npx prettier *",
    "yarn test",
    "yarn lint",
    "pnpm test",
    "pnpm lint",
    "cargo test *",
    "cargo clippy *",
    "cargo fmt *",
    "go test *",
    "go vet *",
    "golangci-lint *",
    "rubocop *",
    "bundle exec rspec *",
    "rails test *"
  ],
  "exact": [
    "git status",
    "git diff",
    "git log",
    "git branch",
    "pip list",
    "pip freeze",
    "python --version",
    "python3 --version",
    "node --version",
    "npm --version",
    "cargo --version",
    "go version",
    "ruby --version"
  ],
  "blocked_patterns": [
    "rm -rf *",
    "rm -r *",
    "sudo *",
    "chmod *",
    "chown *",
    "curl *",
    "wget *",
    "ssh *",
    "scp *",
    "rsync *",
    "docker *",
    "kubectl *",
    "aws *",
    "gcloud *",
    "az *",
    "pip install *",
    "npm install *",
    "yarn add *",
    "pnpm add *"
  ],
  "notes": {
    "patterns": "Glob patterns allowing common development commands",
    "exact": "Exact matches for read-only inspection commands",
    "blocked_patterns": "Commands that should never be allowed in safe mode",
    "custom_additions": "Users can add custom patterns via config.json safety.custom_allowlist"
  }
}
