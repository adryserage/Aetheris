# =============================================================================
# Aetheris - Configuration Example
# =============================================================================
# Copy this file to .env and customize the values for your environment.
# Documentation: https://github.com/adryserage/aetheris
# =============================================================================

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------

# Provider: gemini, openai, or claude
AI_PROVIDER=gemini

# API Keys (set the one matching your provider)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model to use (defaults vary by provider)
# Gemini: gemini-3-pro-preview (recommended), gemini-2.5-pro, gemini-1.5-flash
# OpenAI: gpt-4o, o1-preview, gpt-4-turbo
# Claude: claude-3-5-sonnet-20241022, claude-3-opus-20240229
AI_MODEL=gemini-3-pro-preview

# -----------------------------------------------------------------------------
# Analysis Settings
# -----------------------------------------------------------------------------

# Root directory to analyze (default: current directory)
ROOT_DIR=.

# Output directory for analysis reports
OUTPUT_DIR=docs/analyses

# Architecture report path
ARCHITECTURE_REPORT=docs/architecture_overview.md

# Batch size for parallel analysis
BATCH_SIZE=10

# Maximum retries on API errors
MAX_RETRIES=3

# Timeout per request (seconds)
TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Analysis Features (v2.0.0+)
# -----------------------------------------------------------------------------

# Enable security vulnerability analysis
ENABLE_SECURITY_ANALYSIS=true

# Enable code metrics analysis
ENABLE_METRICS_ANALYSIS=true

# Enable dependency vulnerability scanning (OSV API)
ENABLE_DEPENDENCY_VULNERABILITY=true

# Enable code generation for deep analysis
ENABLE_CODE_GENERATION=true

# Enable web search for documentation
ENABLE_WEB_SEARCH=true
MAX_WEB_RESULTS=3

# Show AI reasoning process (for OpenAI o1 models)
SHOW_REASONING=false

# -----------------------------------------------------------------------------
# Cache Settings (v2.0.0+)
# -----------------------------------------------------------------------------

# Enable analysis cache (reduces API costs by 60-80%)
ENABLE_CACHE=true

# Cache time-to-live in days
CACHE_TTL_DAYS=7

# -----------------------------------------------------------------------------
# Dependency Analysis (v2.0.0+)
# -----------------------------------------------------------------------------

# Analyze files that depend on changed files
ANALYZE_DEPENDENT_FILES=true

# Maximum depth for dependency analysis
MAX_DEPENDENCY_DEPTH=2

# -----------------------------------------------------------------------------
# Performance Monitoring (v2.0.0+)
# -----------------------------------------------------------------------------

# Enable performance metrics collection
ENABLE_METRICS=true

# Enable priority-based analysis (PR files = HIGH priority)
ENABLE_PRIORITY_ANALYSIS=true

# -----------------------------------------------------------------------------
# Bug Detection Features (v2.1.0+)
# -----------------------------------------------------------------------------

# Enable export extraction (TS/JS, Python, Dart)
ENABLE_EXPORT_ANALYSIS=true

# Enable reverse dependency graph
ENABLE_REVERSE_DEPENDENCY=true

# Enable bug impact analysis
ENABLE_IMPACT_ANALYSIS=true

# Maximum depth for impact analysis
MAX_IMPACT_DEPTH=3

# Enable Claude Code integration for bug fixes
ENABLE_CLAUDE_CODE_FIX=true

# Minimum severity for bug fixes (critical, high, medium, low)
FIX_SEVERITY_THRESHOLD=medium

# -----------------------------------------------------------------------------
# Gemini Advanced Features (v2.2.0+)
# -----------------------------------------------------------------------------
#
# ⚠️ INCOMPATIBILITIES - Some features cannot be used together:
#   - ENABLE_THINKING cannot be used with: Structured Outputs, Code Execution, Function Calling
#   - ENABLE_STRUCTURED_OUTPUTS cannot be used with: Thinking mode
#   - ENABLE_CODE_EXECUTION cannot be used with: Thinking mode
#   - ENABLE_FUNCTION_CALLING cannot be used with: Thinking mode
#
# RECOMMENDED CONFIGURATION:
#   Option 1 (Default): Structured Outputs only (most reliable)
#   Option 2: Thinking mode only (for debugging/transparency)
#   Option 3: Code Execution + Structured Outputs (for dynamic analysis)
# -----------------------------------------------------------------------------

# Enable Structured Outputs (JSON validated via Pydantic)
# ⚠️ Cannot be used with ENABLE_THINKING=true
ENABLE_STRUCTURED_OUTPUTS=true

# Enable Thinking/Reasoning mode (visible AI thought process)
# ⚠️ Cannot be used with: Structured Outputs, Code Execution, Function Calling
ENABLE_THINKING=false

# Token budget for Thinking mode (minimum 128, only used if ENABLE_THINKING=true)
THINKING_BUDGET=1024

# Enable Python code execution in sandbox
# ⚠️ Cannot be used with ENABLE_THINKING=true
ENABLE_CODE_EXECUTION=false

# Enable automatic function calling
# ⚠️ Cannot be used with ENABLE_THINKING=true
ENABLE_FUNCTION_CALLING=false

# Enable Gemini context caching (-50% API cost)
# ✅ Compatible with all features
ENABLE_CONTEXT_CACHING=true

# Context cache time-to-live (seconds)
CONTEXT_CACHE_TTL_SECONDS=3600

# Enable Batch API for bulk processing (-50% API cost)
# ✅ Compatible with all features
ENABLE_BATCH_MODE=false

# Enable Google Search for grounding
# ✅ Compatible with most features
ENABLE_GOOGLE_SEARCH=false
