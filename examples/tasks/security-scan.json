{
  "version": "1.0",
  "task": {
    "type": "analysis",
    "target": {
      "files": ["src/**/*.py", "src/**/*.js", "src/**/*.ts"],
      "exclude": ["**/node_modules/**", "**/.git/**"]
    },
    "options": {
      "timeout": "45m",
      "profile": "safe",
      "agents": ["security", "dependency"]
    }
  },
  "output": {
    "format": "json",
    "include_diff": false,
    "include_logs": true
  },
  "metadata": {
    "scan_type": "security",
    "triggered_by": "scheduled"
  }
}
